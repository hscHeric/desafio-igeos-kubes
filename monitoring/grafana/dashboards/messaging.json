  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(producer_http_requests_total[5m])) + sum(rate(consumer_http_requests_total[5m]))", "refId": "A"}],
      "title": "Requisições por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(producer_http_requests_total{status=~\"4..|5..\"}[5m])) + sum(rate(consumer_http_requests_total{status=~\"4..|5..\"}[5m]))", "refId": "A"}],
      "title": "Erros HTTP por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(increase(consumer_messages_persisted_total[5m]))", "refId": "A"}],
      "title": "Mensagens persistidas nos últimos 5 minutos",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(consumer_processing_lag_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "title": "Atraso p95 do consumidor",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "consumer_worker_up", "refId": "A"}],
      "title": "Worker do consumidor (1=ativo)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"expr": "count(ALERTS{alertstate=\"firing\"})", "refId": "A"}],
      "title": "Alertas ativas",
      "type": "stat"
    }
